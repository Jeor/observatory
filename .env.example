OBSERVATORY_MODE=demo
OBSERVATORY_TIMEZONE=UTC
OBSERVATORY_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
# Live Docker mode requires a dashboard login file inside the container:
# OBSERVATORY_AUTH_FILE=/run/secrets/dashboard-login.json
# AIOM_ORIGIN=http://your-aiometadata:3232
# STREAMS_ORIGIN=http://your-aiostreams:3004
# Native Node only: also set the secret file paths in docs/public/development.md.
